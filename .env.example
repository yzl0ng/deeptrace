# DeepTrace local persistence
SEARCHLAB_DATABASE_PATH=data/searchlab.db
SEARCHLAB_UPLOAD_DIR=data/uploads
SEARCHLAB_MAX_UPLOAD_MB=20
SEARCHLAB_DEFAULT_CHUNK_SIZE=800
SEARCHLAB_DEFAULT_CHUNK_OVERLAP=120
# Include every browser origin that may call the local/public FastAPI service.
SEARCHLAB_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dense retrieval
DENSE_MODEL_NAME=BAAI/bge-m3
DENSE_DEVICE=auto
DENSE_BATCH_SIZE=8

# Optional reranker
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=512

# DeepTrace-R1. Enable explicitly when running the Agent API.
DEEPTRACE_ENABLED=false
DEEPTRACE_DATABASE_PATH=data/deeptrace-v2.db
DEEPTRACE_STORAGE_NAMESPACE=agentic_v2
DEEPTRACE_EXPERIMENT_NAMESPACE=deeptrace-v2
DEEPTRACE_SEARCH_PROVIDER=local
DEEPTRACE_WORKFLOW=supervisor
DEEPTRACE_MAX_QUERY_REWRITES=1
DEEPTRACE_EVIDENCE_DATABASE_PATH=data/deeptrace-evidence-v2.db
DEEPTRACE_MAX_WALL_TIME_SECONDS=900
DEEPTRACE_MAX_AGENT_STEPS=40
DEEPTRACE_MAX_SEARCH_CALLS=20
DEEPTRACE_MAX_PAGE_READS=20
DEEPTRACE_MAX_TOTAL_TOKENS=120000
DEEPTRACE_MAX_PARALLEL_RESEARCH_UNITS=4
DEEPTRACE_MAX_CONTEXT_TOKENS=32000
DEEPTRACE_MAX_API_COST=5.0

# Optional Phase 2 provider credential; required only when
# DEEPTRACE_SEARCH_PROVIDER=brave.
BRAVE_SEARCH_API_KEY=

# Server-only LLM credentials; never expose this file to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
RAG_RETRIEVAL_TOP_K=5
RAG_MAX_CONTEXT_CHARS=12000
RAG_REQUEST_TIMEOUT_SECONDS=60
